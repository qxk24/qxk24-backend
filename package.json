{
  "name": "qxk24-backend",
  "version": "1.7.0",
  "description": "QXK24 Constitutional Kernel — Standalone Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prebuild": "node scripts/sync-teaching-bridge.mjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "quran:fetch": "node scripts/fetch-quran-corpus.mjs",
    "backfill:teaching-records": "ts-node --transpile-only src/scripts/backfill-teaching-records.ts",
    "backfill:teaching-records:lab": "QXK24_STACK=lab ts-node --transpile-only src/scripts/backfill-teaching-records.ts",
    "finalise:journal": "ts-node --transpile-only src/scripts/finalise-journal.ts",
    "migrate:journal-v2": "node scripts/migrate-journal-schema-v2.mjs",
    "atlas:audit": "node scripts/atlas-storage-rescue.mjs",
    "atlas:rescue": "node scripts/atlas-storage-rescue.mjs --execute logs,ledger,snapshots",
    "ama:neuro-validate": "ts-node --transpile-only src/scripts/ama-neuro-validate.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/lib-storage": "^3.1055.0",
    "@hono/node-server": "^1.8.2",
    "@hono/zod-validator": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "google-auth-library": "^9.15.1",
    "hono": "^4.2.7",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mongodb": "6.20.0",
    "mongoose": "^8.0.0",
    "pdf-parse": "^2.4.5",
    "ppt": "^0.0.2",
    "redis": "^6.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "overrides": {
    "mongodb": "6.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
