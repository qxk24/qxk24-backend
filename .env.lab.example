# ============================================================
# QXK24 ADAM Lab — Qwen stack (copy to .env.lab on VPS)
# Same codebase as production. Different env only.
# NEVER commit .env.lab with real secrets.
# ============================================================

NODE_ENV=production
PORT=5002
APP_BASE_URL=https://api.qxk24.com/lab
QXK24_STACK=lab
LLM_PROVIDER=qwen
ADAM_DEFAULT_LANGUAGE=malay

# Web search — agent mode (model decides when, like Claude). forced_search stays false.
QWEN_ENABLE_SEARCH=true
QWEN_SEARCH_STRATEGY=agent
QWEN_SEARCH_ENABLE_CITATION=false
QWEN_ENABLE_THINKING=false
QURAN_CORPUS_ENABLED=true

# Lab context budget — smaller brain/history for faster Qwen turns
ADAM_FOUNDER_BRAIN_CHARS=8000
ADAM_FOUNDER_MESSAGE_WINDOW=12

# Separate database — lab brain must not mix with production Claude backup
MONGODB_URI=mongodb://localhost:27017/qxk24_lab

# Auth — same founder/student passwords as production for pilot (Founder + 2 students)
JWT_SECRET=CHANGE_ME_lab_jwt
FOUNDER_PASSWORD=CHANGE_ME
STUDENT_PASSWORDS=izwahanie:CHANGE_ME,suhaila:CHANGE_ME

CORS_ORIGINS=https://qxk24.com,https://api.qxk24.com

# Qwen / DashScope (Model Studio API key)
DASHSCOPE_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_DEEP=qwen-plus
QWEN_MODEL_FAST=qwen-turbo
QWEN_MODEL_VISION=qwen-vl-max

# Optional: reduce lab background cost
ADAM_REFLECTION_ENABLED=false
ADAM_BACKUP_ENABLED=false

# Shared infra (same VPS Redis/R2 as production is OK for pilot)
REDIS_URL=redis://localhost:6379
R2_BUCKET_NAME=qxk24-adam-lab-knowledge

# Leave Anthropic empty on lab — production stack holds Claude backup
# ANTHROPIC_API_KEY=
