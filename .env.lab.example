# AMA Brain v2 — Lab stack (.env.lab)
# Copy to alm-backend/.env on lab VPS after Tahap 4 neuro gate passes.
# NEVER reduce ADAM_*_BRAIN_CHARS or token limits on this file.

QXK24_STACK=lab

# Tahap 1–3 — dual lane + controlled OASS
ADAM_AMA_BRAIN_V2=true
# ADAM_AMA_TAMAT_OASS=false   # uncomment to rollback Tahap 2 single-lane

# Tahap 4 — Langkah 6 neuro validation (run scripts/ama-neuro-validate.ts first)
ADAM_AMA_NEURO_VALIDATION=true
ADAM_AMA_NEURO_CALIBRATE=true
ADAM_AMA_NEURO_GATE_PASSED=true

# Sacred memory — do not alter
# ADAM_FOUNDER_BRAIN_CHARS=48000
# ADAM_QWEN_FAST_MAX_TOKENS=4096
# ADAM_FOUNDER_DEEP_MAX_TOKENS=8192
