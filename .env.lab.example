# ============================================================
# QXK24 ADAM Lab — Qwen stack (copy to .env.lab on VPS)
# Same codebase as production. Different env only.
# NEVER commit .env.lab with real secrets.
# ============================================================

NODE_ENV=production
PORT=5002
APP_BASE_URL=https://api.qxk24.com/lab
QXK24_STACK=lab
LLM_PROVIDER=qwen
ADAM_DEFAULT_LANGUAGE=malay

# Web search — agent mode (model decides when, like Claude). forced_search stays false.
QWEN_ENABLE_SEARCH=true
QWEN_SEARCH_STRATEGY=agent
QWEN_SEARCH_ENABLE_CITATION=false
QWEN_ENABLE_THINKING=false
# Optional — requires Alibaba whitelist on the API account:
# QWEN_DATA_INSPECTION={"input":"disable","output":"disable"}
QURAN_CORPUS_ENABLED=true

# Lab memory — full depth (same as production).
# ⚠️  NEVER CHANGE THE SETTING — Founder approval only. See .cursor/rules/adam-memory-sacred-settings.mdc
ADAM_FOUNDER_BRAIN_CHARS=48000
ADAM_FOUNDER_MESSAGE_CHARS=8000
ADAM_FOUNDER_MESSAGE_WINDOW=30
ADAM_STUDENT_BRAIN_CHARS=24000
ADAM_STUDENT_MESSAGE_CHARS=4000
# ADAM_LAB_MEMORY_LITE=false  # NEVER enable without Founder approval
# Qwen turbo output (NEVER CHANGE THE SETTING — minimum 4096)
ADAM_QWEN_FAST_MAX_TOKENS=4096
# Long journal manuscripts — output token budget (default 8192; raise if DashScope allows)
ADAM_JOURNAL_MAX_TOKENS=8192
ADAM_FOUNDER_DEEP_MAX_TOKENS=8192

# Separate database — lab brain must not mix with production Claude backup
MONGODB_URI=mongodb://localhost:27017/qxk24_lab
# Read production DB to import student books/history into lab.
# On VPS: use the SAME Atlas URI as production .env (MONGODB_URI), NOT localhost qxk24.
# Localhost qxk24 is empty when production runs on MongoDB Atlas.
PRODUCTION_MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.net/qxk24

# Auth — same founder/student passwords as production for pilot
JWT_SECRET=CHANGE_ME_lab_jwt
FOUNDER_PASSWORD=CHANGE_ME
STUDENT_PASSWORDS=izwahanie:CHANGE_ME,suhaila:CHANGE_ME,aziz-tamhid:CHANGE_ME,amer:CHANGE_ME,iskandar:CHANGE_ME,haqimi:CHANGE_ME
# Or per-student:
# STUDENT_PASSWORD_ISKANDAR=your_password_here
# STUDENT_PASSWORD_HAQIMI=your_password_here

CORS_ORIGINS=https://qxk24.com,https://api.qxk24.com

# Google Sign-In + password reset email (students)
# Google Sign-In — new users are auto-created on first Google sign-in (up to ADAM_STUDENT_REGISTER_MAX)
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# ADAM_GOOGLE_SIGNIN_ENABLED=true
# GOOGLE_ALLOWED_EMAIL_DOMAINS=gmail.com
# RESEND_API_KEY=re_...
# MAIL_FROM=ADAM Lab <noreply@qxk24.com>
# ADAM_WEB_BASE_URL=https://qxk24.com
# ADAM_PASSWORD_RESET_ENABLED=true
# ADAM_PASSWORD_RESET_TTL_MINUTES=60

# Qwen / DashScope (Model Studio API key)
DASHSCOPE_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_DEEP=qwen-plus
QWEN_MODEL_FAST=qwen-turbo
QWEN_MODEL_VISION=qwen-vl-max

# Optional: reduce lab background cost
ADAM_REFLECTION_ENABLED=false
ADAM_BACKUP_ENABLED=false

# Shared infra (same VPS Redis/R2 as production is OK for pilot)
REDIS_URL=redis://localhost:6379
R2_BUCKET_NAME=qxk24-adam-lab-knowledge

# Leave Anthropic empty on lab — production stack holds Claude backup
# ANTHROPIC_API_KEY=

# ─── Subscriptions & Payments (optional until live) ───────────────────────────
# APP_URL=https://qxk24.com
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_ID_PELAJAR=
# RAZORPAY_PLAN_ID_PROFESIONAL=
# ─── Stripe (Global — set STRIPE_ENABLED=true when ready) ─────────────────────
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PELAJAR_MONTHLY=price_...
# STRIPE_PRICE_ID_PELAJAR_ANNUAL=price_...
# STRIPE_PRICE_ID_PROFESIONAL_MONTHLY=price_...
# STRIPE_PRICE_ID_PROFESIONAL_ANNUAL=price_...
# Webhook URL: https://api.qxk24.com/api/subscriptions/webhooks/stripe
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PLAN_CODE_PELAJAR=
# PAYSTACK_PLAN_CODE_PROFESIONAL=
# PADDLE_API_KEY=
# PADDLE_PRICE_ID_PELAJAR_MONTHLY=
# PADDLE_PRICE_ID_PELAJAR_ANNUAL=
# PADDLE_PRICE_ID_PROFESIONAL_MONTHLY=
# PADDLE_PRICE_ID_PROFESIONAL_ANNUAL=
