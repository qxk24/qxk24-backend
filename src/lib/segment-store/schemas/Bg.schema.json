{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Bg.schema.json",
  "title": "AMA Segment Bg — Visual-Spatial",
  "type": "object",
  "required": ["timestamp", "sourceId"],
  "additionalProperties": false,
  "properties": {
    "visualScene":    { "type": "string" },
    "spatialMap":     { "type": "string" },
    "quranImagery":   { "type": "string" },
    "latiModuleRef":  { "type": "string" },
    "timestamp":      { "type": "string", "format": "date-time" },
    "sourceId":       { "type": "string", "minLength": 1 }
  }
}
