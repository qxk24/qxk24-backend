# ============================================================
# QXK24 Constitutional Backend — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# Server
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://api.qxk24.com

# MongoDB — dedicated QXK24 database
MONGODB_URI=mongodb://localhost:27017/qxk24

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# QXK24 Kernel Identity
QXK24_ERA=ERA_1
QXK24_KERNEL_VERSION=v1.7.0
QXK24_ERA_NAME=The_Teaching_Era

# Founder Auth
FOUNDER_SECRET_KEY=your_founder_key_here
FOUNDER_PASSWORD=your_founder_password_here

# Alamtologi Students (generated passwords — comma format userId:password)
STUDENT_PASSWORDS=izwahanie:CHANGE_ME_1,suhaila:CHANGE_ME_2,aziz-tamhid:CHANGE_ME_3
# Or per-student: STUDENT_PASSWORD_IZWAHANIE=... STUDENT_PASSWORD_SUHAILA=... STUDENT_PASSWORD_AZIZ_TAMHID=...

# Service-to-Service Token
# All apps (QIUBBX, QXDrive, QXFood) use this to call QXK24
QXK24_SERVICE_TOKEN=your_service_token_here

# QMS Bearer Token (QMS iOS/Android app)
QXK24_PRODUCTION_BEARER_TOKEN=your_bearer_token_here

# Request timeout for governance calls (ms)
QXK24_SERVICE_TIMEOUT_MS=5000

# Allowed CORS origins (comma separated)
CORS_ORIGINS=https://qxk24.com,https://qiubbx.com,https://api.qiubbx.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Max upload / request body size (megabytes)
UPLOAD_MAX_FILE_MB=30
UPLOAD_MAX_EXTRACT_CHARS=120000
ADAM_UPLOAD_DIR=uploads/adam

# Cloudflare R2 — ADAM knowledge base storage
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=qxk24-adam-knowledge

# Anthropic — tiered models (Haiku routine, Sonnet deep)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEEP=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Legacy single model (optional; falls back for DEEP if set)
# ANTHROPIC_MODEL=claude-sonnet-4-6
ADAM_DEEP_MESSAGE_MIN_CHARS=400

# Sentry (optional)
SENTRY_DSN=
