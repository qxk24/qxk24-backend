# ============================================================
# QXK24 Constitutional Backend — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# Server
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://api.alamtologi.com

# MongoDB — dedicated QXK24 database
MONGODB_URI=mongodb://localhost:27017/alamtologi

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# QXK24 Kernel Identity
QXK24_ERA=ERA_1
QXK24_KERNEL_VERSION=v1.7.0
QXK24_ERA_NAME=The_Teaching_Era

# ADAM voice — fallback when speaker language unclear (malay | english | any label)
ADAM_DEFAULT_LANGUAGE=english

# Founder Auth (quote password if it contains # or spaces)
FOUNDER_SECRET_KEY=your_founder_key_here
FOUNDER_PASSWORD="your_founder_password_here"

# Alamtologi Students (generated passwords — comma format userId:password)
STUDENT_PASSWORDS=izwahanie:CHANGE_ME_1,suhaila:CHANGE_ME_2,aziz-tamhid:CHANGE_ME_3,amer:CHANGE_ME_4,iskandar:CHANGE_ME_5,haqimi:CHANGE_ME_6,pelajar-test:PelajarTest2026,sabrina:sabrina1234
# Or per-student (recommended for new students):
# STUDENT_PASSWORD_ISKANDAR=your_password_here
# STUDENT_PASSWORD_HAQIMI=your_password_here
# ADAM Tutor QA accounts (lane: pelajar)
# STUDENT_PASSWORD_PELAJAR_TEST=PelajarTest2026
# STUDENT_PASSWORD_SABRINA=sabrina1234

# Freemium — guest try + registered daily caps (MY timezone reset at midnight)
# ADAM_FREEMIUM_ENABLED=true
# ADAM_FREEMIUM_PUBLIC_ENABLED=true
# ADAM_FREEMIUM_GUEST_LIMIT=3
# ADAM_FREEMIUM_FREE_DAILY=20
# ADAM_CONSUMER_DAILY_PLAN=true
# ADAM_FREEMIUM_PRO_DAILY=100
# ADAM_EXTRA_MESSAGE_COST_CENTS=12
# ADAM_PRO_MONTHLY_USD=19
# ADAM_PRO_ANNUAL_USD=200
# STRIPE_PRICE_ID_PRO_MONTHLY=price_xxxxxxxx              # Pro — $19 USD/month
# STRIPE_PRICE_ID_PRO_ANNUAL=price_xxxxxxxx               # Pro — $200 USD/year
# ADAM_PREMIUM_MONTHLY_USD=75
# ADAM_PREMIUM_ANNUAL_USD=800
# ADAM Tutor kod-daftar — flat USD/month (student checkout via universal PIN)
# ADAM_TUTOR_AGENT_MONTHLY_USD=15.90
# STRIPE_PRICE_ID_CREDITS_10=price_xxxxxxxx                 # Token — $10 USD
# STRIPE_PRICE_ID_CREDITS_50=price_xxxxxxxx                 # Token — $50 bundle
# STRIPE_PRICE_ID_CREDITS_200=price_xxxxxxxx                # Token — $200 bundle
# ADAM_FREEMIUM_FREE_ROLLING=4
# ADAM_FREEMIUM_ROLLING_WINDOW_HOURS=5
# ADAM_FREEMIUM_PELAJAR_MONTHLY=50
# ADAM_FREEMIUM_PELAJAR_DAILY_SOFT=5
# ADAM_FREEMIUM_PROFESIONAL_ROLLING=18
# ADAM_FREEMIUM_FREE_DAILY=15  # deprecated — use FREE_ROLLING
# ADAM_FREEMIUM_PELAJAR_DAILY=100  # deprecated
# ADAM_FREEMIUM_CREDIT_PACK_SIZE=25
# ADAM_FREEMIUM_TIMEZONE=Asia/Kuala_Lumpur

# Layer 2 — ADAM Jurnal / Buku / Kod (server output). Keep false until full QA.
# ADAM_LAYER2_ENABLED=false

# Student self-registration (public web /register)
# ADAM_STUDENT_SELF_REGISTER=true  # default on — email signup open on ERA_1 freemium
# ADAM_STUDENT_REGISTER_CODE=optional-invite-code
# ADAM_STUDENT_REGISTER_MAX=200

# VIP tester cohort (public /tester/apply + founder approval)
# ADAM_TESTER_COHORT_MAX=100
# ADAM_TESTER_APPLY_ENABLED=true

# Google Sign-In + password reset email (students)
# Required on production after lab consolidation — auth-config returns googleEnabled:false if unset.
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# ADAM_GOOGLE_SIGNIN_ENABLED=true  # Google signup works when client ID is set (independent of manual /register gate)
# GOOGLE_ALLOWED_EMAIL_DOMAINS=gmail.com
# MAIL_FROM must use a domain verified in Resend (e.g. updates.alamtologi.com).
# MAIL_REPLY_TO should use the SAME domain as MAIL_FROM — mismatched root domain hurts Gmail delivery.
# RESEND_API_KEY=re_...
# MAIL_FROM=ADAM Tutor <info@updates.alamtologi.com>
# MAIL_REPLY_TO=info@updates.alamtologi.com
# ADAM_WEB_BASE_URL=https://alamtologi.com
# ADAM_PASSWORD_RESET_ENABLED=true
# ADAM_PASSWORD_RESET_TTL_MINUTES=60

# Service-to-Service Token
# All apps (QIUBBX, QXDrive, QXFood) use this to call QXK24
QXK24_SERVICE_TOKEN=your_service_token_here

# QMS Bearer Token (QMS iOS/Android app)
QXK24_PRODUCTION_BEARER_TOKEN=your_bearer_token_here

# Request timeout for governance calls (ms)
QXK24_SERVICE_TIMEOUT_MS=5000

# Allowed CORS origins (comma separated)
CORS_ORIGINS=https://alamtologi.com,https://www.alamtologi.com,https://qxk24.com,https://www.qxk24.com,https://qiubbx.com,https://api.qiubbx.com,http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Max upload / request body size (megabytes)
UPLOAD_MAX_FILE_MB=50
UPLOAD_MAX_EXTRACT_CHARS=120000
# Max PDF pages parsed per upload (lower = less RAM; default 25)
UPLOAD_PDF_MAX_PAGES=8
# PDF text extraction ceiling in child (fail fast before pdf.js)
UPLOAD_PDF_PARSE_MAX_MB=40
# DOCX/PPTX parse ceiling in child (fail fast before mammoth/JSZip)
UPLOAD_OFFICE_PARSE_MAX_MB=50
ADAM_UPLOAD_DIR=uploads/adam

# Cloudflare R2 — ADAM knowledge base storage
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=qxk24-adam-knowledge

# Cloudinary — founder blog (cover, inline images, video)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BLOG_FOLDER=alamtologi/blog
BLOG_IMAGE_MAX_MB=15
BLOG_VIDEO_MAX_MB=100

ADAM_DEEP_MESSAGE_MIN_CHARS=400

# Stack identity — production only (lab stack is obsolete)
QXK24_STACK=production
LLM_PROVIDER=qwen

# DEVICE BRIDGE — Builder MCP + local file daemon (Mac / Windows / Linux)
# Founder + Profesional: dashboard Bridge switch + alm-mcp `npm run mac-bridge`
ADAM_BUILDER_ENABLED=true
ADAM_MAC_BRIDGE_ENABLED=true

HAWA_ENABLED=true

# ADAM Gateway (qxk24-adam PM2) — Plas Point-1 for student chat (Path A)
# ADAM_GATEWAY_URL=http://127.0.0.1:4010
# ADAM_GATEWAY_PLAS_ENABLED=true
# ADAM_GATEWAY_TIMEOUT_MS=8000
# ADAM_GATEWAY_PLAS_FAIL_CLOSED=false

# Qwen / DashScope — required for ADAM chat on production
DASHSCOPE_API_KEY=
# Singapore / international Model Studio (default for QXK24 production):
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Mainland China keys only: https://dashscope.aliyuncs.com/compatible-mode/v1
# Wrong region → 401 invalid_api_key even when the key string is correct.
QWEN_MODEL_DEEP=qwen-plus
QWEN_MODEL_FAST=qwen-turbo
QWEN_MODEL_VISION=qwen-vl-max
# QWEN_ENABLE_THINKING=false — default; set true only if deep constitutional reasoning needed
# Student latency — true = one LLM call with inline search (default). false = slower blocking prefetch.
ADAM_STUDENT_INLINE_SEARCH=true
# Unified transform — student inquiry grows Brain C (A → C)
ADAM_UNIFIED_TRANSFORM=true
ADAM_INQUIRY_TRANSFORM=true
# P4 — merge inquiry C into master (audit pending; default off)
# ADAM_INQUIRY_MASTER_MERGE=false
# Qwen web search (founder + student chat): agent = model decides when to search
QWEN_ENABLE_SEARCH=true
QWEN_SEARCH_STRATEGY=agent
QWEN_SEARCH_ENABLE_CITATION=true

# Verified Quran corpus (Rasm Uthmani + Pickthall — ayat only, no tafsir)
QURAN_CORPUS_ENABLED=true

# BM Malaysia lexicon — curated BM/ID divergence (on-demand injection, not full kamus)
BM_LEXICON_ENABLED=true

# ADAM memory tiers (founder / student / workspace context windows)
# ⚠️  NEVER CHANGE THE SETTING — Founder approval only. See .cursor/rules/adam-memory-sacred-settings.mdc
ADAM_FOUNDER_MESSAGE_WINDOW=30
ADAM_FOUNDER_BRAIN_CHARS=48000
ADAM_FOUNDER_MESSAGE_CHARS=8000
# smart = load vault/stage/audit blocks only when message needs them (faster routine chat)
# always | never
ADAM_FOUNDER_DEEP_BLOCKS=smart
ADAM_STUDENT_MESSAGE_WINDOW=20
ADAM_STUDENT_BRAIN_CHARS=24000
ADAM_STUDENT_MESSAGE_CHARS=6000
ADAM_WORKSPACE_MESSAGE_WINDOW=20
ADAM_WORKSPACE_BRAIN_CHARS=32000

# AMA Brain v2 — dual lane IKJ/LWJ (Kotak 2/3). Lab first: ADAM_AMA_BRAIN_V2=true
# ADAM_AMA_BRAIN_V2=false
# Tahap 3 — OASS on by default when v2 active; set false to force Tahap 2 single-lane
# ADAM_AMA_TAMAT_OASS=false
# Tahap 4 — Langkah 6 neuro validation (EEG/HRV/RSA). Run: npm run ama:neuro-validate
# ADAM_AMA_NEURO_VALIDATION=false
# ADAM_AMA_NEURO_CALIBRATE=true
# ADAM_AMA_NEURO_GATE_PASSED=true
ADAM_WORKSPACE_MESSAGE_CHARS=6000

# Qwen — max output tokens (NEVER CHANGE THE SETTING — fast minimum 4096; deep minimum 8192)
ADAM_QWEN_FAST_MAX_TOKENS=4096
ADAM_FOUNDER_DEEP_MAX_TOKENS=8192
ADAM_STUDENT_DEEP_MAX_TOKENS=8192

# Session sleep — inactivity before ADAM sleep synthesis (ms, default 30 min)
ADAM_SESSION_SLEEP_MS=1800000

# Dedicated ADAM box (24/7 own hardware — local inference, zero API spend)
# ADAM_DEDICATED_HARDWARE=true
# On dedicated: journal batch auto-enables (659 subfields/day) unless ADAM_JOURNAL_BATCH_ENABLED=false
# ADAM_JOURNAL_BATCH_INTERVAL_MS=180000
# ADAM_JOURNAL_BATCH_SIZE=8
# ADAM_JOURNAL_BATCH_PAUSE_MS=1500

# Cloud VPS only — batch opt-in
# ADAM_JOURNAL_BATCH_ENABLED=false
# ADAM_JOURNAL_BATCH_INTERVAL_MS=900000
# ADAM_JOURNAL_BATCH_SIZE=2
# ADAM_JOURNAL_BATCH_PAUSE_MS=4000

# Nightly reflection — ADAM thinks alone while P.alt is away (cron via scheduler)
ADAM_REFLECTION_ENABLED=true
ADAM_REFLECTION_HOUR=3
ADAM_REFLECTION_MINUTE=0
ADAM_REFLECTION_TIMEZONE=Asia/Kuala_Lumpur

# Atomic message guarantee — write-ahead ledger recovery (Layer 1)
ADAM_ATOMIC_RECOVERY_ENABLED=true
ADAM_ATOMIC_RECOVERY_MS=300000

# Transformation integrity guard — checksum + nightly scan (Layer 2)
ADAM_INTEGRITY_ENABLED=true
ADAM_INTEGRITY_HOUR=4
ADAM_INTEGRITY_MINUTE=0
ADAM_INTEGRITY_TIMEZONE=Asia/Kuala_Lumpur

# Three-tier memory — working / short-term digest / long-term brain (Layer 3)
ADAM_WORKING_MEMORY_EXCHANGES=5
ADAM_SESSION_DIGEST_INTERVAL=10

# Quantum state snapshots — pre-transformation rollback (Layer 6)
ADAM_SNAPSHOT_RETENTION=2
# TTL auto-deletes SUPERSEDED/RESTORED (hours); ACTIVE snapshots are kept until pruned
ADAM_SNAPSHOT_SUPERSEDED_TTL_HOURS=24
ADAM_SNAPSHOT_RESTORED_TTL_HOURS=168

# Concurrent access guard — Redis distributed lock (Layer 8)
REDIS_URL=redis://localhost:6379
ADAM_LOCK_TIMEOUT_MS=30000
ADAM_LOCK_POLL_MS=100
ADAM_LOCK_MAX_ATTEMPTS=50

# Teaching Continuity Protocol — semantic chunking for long teachings (Layer 9)
ADAM_TCP_MAX_CHUNK_CHARS=3000
ADAM_TCP_CHUNK_DELAY_MS=500

# Memory redundancy — 3-2-1 backup rule, encrypted R2 (Layer 10)
ADAM_BACKUP_ENABLED=true
ADAM_BACKUP_HOUR=2
ADAM_BACKUP_MINUTE=0
ADAM_BACKUP_TIMEZONE=Asia/Kuala_Lumpur
ADAM_BACKUP_ENCRYPTION_KEY=
ADAM_ATLAS_SECONDARY_REGION=

# Sentry (optional)
SENTRY_DSN=

# ─── Subscriptions & Payments ─────────────────────────────────────────────────
APP_URL=https://alamtologi.com
# Stripe is the sole payment gateway — regional PPP amounts at checkout (all countries).
# ─── Stripe — 3 product families only ─────────────────────────────────────────
# 1. Pro (monthly/annual)  2. Ejen PIN packages (4 tiers)  3. Token credits
# Tutor student checkout uses dynamic price_data (ADAM_TUTOR_AGENT_MONTHLY_USD).
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_... or sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_test_... or pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# 1. Pro
# STRIPE_PRICE_ID_PRO_MONTHLY=price_xxxxxxxx              # $19 USD/month
# STRIPE_PRICE_ID_PRO_ANNUAL=price_xxxxxxxx               # $200 USD/year
#
# 2. Ejen — one-time MYR PIN packages (universal PIN, all levels)
# STRIPE_PRICE_ID_TUTOR_EJEN_SILVER=price_xxx       # RM 200   (100 PIN)
# STRIPE_PRICE_ID_TUTOR_EJEN_GOLD=price_xxx         # RM 900   (500 PIN)
# STRIPE_PRICE_ID_TUTOR_EJEN_DIAMOND=price_xxx      # RM 1,600 (1,000 PIN)
# STRIPE_PRICE_ID_TUTOR_EJEN_PLATINUM=price_xxx     # RM 2,100 (1,500 PIN)
#
# 3. Token
# STRIPE_PRICE_ID_CREDITS_10=price_xxxxxxxx             # $10 USD
# STRIPE_PRICE_ID_CREDITS_50=price_xxxxxxxx             # $50 bundle
# STRIPE_PRICE_ID_CREDITS_200=price_xxxxxxxx            # $200 bundle
#
# ADAM_TUTOR_AGENT_MONTHLY_USD=15.90                    # Student kod-daftar checkout (dynamic)
# ADAM_TUTOR_BILLING_REQUIRED=true                     # Gate /adam/tutor when Stripe is live
# Webhook URL: https://api.alamtologi.com/api/subscriptions/webhooks/stripe

# AI image/video generation (Wanx / DashScope) — paused for now; focus is text + voice.
ADAM_MEDIA_GENERATION_ENABLED=false
# DASHSCOPE_API_KEY=sk-...                             # Same key as Qwen
# APP_BASE_URL=https://api.alamtologi.com
# R2_PUBLIC_BASE_URL=https://media.alamtologi.com      # Optional CDN; else /api/adam/media/generated
# ADAM_WANX_IMAGE_MODEL=wanx2.1-t2i-turbo
# ADAM_MEDIA_IMAGE_MONTHLY_PRO=10
# ADAM_MEDIA_IMAGE_MONTHLY_TUTOR=15
